# Основные настройки бренда
APP_NAME=Lider VPN
SHOW_ONBOARDING=true

# Интеграция с Telegram (твои боты)
TELEGRAM_BOT_URL=t.me/vpn_fr2026_bot
TELEGRAM_SUPPORT_URL=t.me/lider_vpn_support_bot 

# Включение функций
SHOW_STAT_BAR=true
SHOW_APPS_PAGE=true
SHOW_SETTINGS_PAGE=true
ENABLE_DEEP_LINKS=true
AUTO_CONNECT_ON_START=false
ENABLE_KILL_SWITCH=true
DEBUG_MODE=false

# Ссылка на подписку (пока оставляем пустой, потом разберемся)
SUBSCRIPTION_URL_MAIN=
